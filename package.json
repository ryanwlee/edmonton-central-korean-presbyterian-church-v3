{
  "name": "church",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/default-layout": "^3.12.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "pdfjs-dist": "3.4.120",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "react-scripts": "5.0.1",
    "styled-components": "^6.5.3",
    "web-vitals": "^6.2.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "CI=true react-scripts test --watchAll=false",
    "test:visual": "npm run build && playwright test",
    "test:visual:update": "npm run build && playwright test --update-snapshots",
    "test:all": "npm run test:ci && npm run test:visual",
    "eject": "react-scripts eject"
  },
  "jest": {
    "moduleNameMapper": {
      "^@react-pdf-viewer/core$": "<rootDir>/src/test-utils/pdfViewerStub.js",
      "^@react-pdf-viewer/default-layout$": "<rootDir>/src/test-utils/pdfViewerStub.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@emotion/jest": "^11.14.2",
    "@playwright/test": "^1.62.1",
    "jest-styled-components": "^7.4.0",
    "prettier": "^3.9.6",
    "serve": "^14.2.6"
  },
  "overrides": {
    "webpack": "5.88.2",
    "eslint": "8.57.1",
    "react-refresh": "0.11.0"
  }
}
